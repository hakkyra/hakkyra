{
  "name": "hakkyra",
  "version": "0.1.0",
  "description": "Auto-generate GraphQL + REST APIs from PostgreSQL with Hasura-compatible configuration",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "hakkyra": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/cli.ts dev",
    "start": "node dist/cli.js start",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/ --ext .ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=26"
  },
  "license": "MIT",
  "dependencies": {
    "fastify": "^5.12.7",
    "fastify-plugin": "^6.0.1",
    "graphql": "^17.0.2",
    "graphql-ws": "^6.4.1",
    "jose": "^6.2.14",
    "js-yaml": "^5.5.0",
    "kriti-lang": "^1.0.0",
    "mercurius": "^16.12.1",
    "pg": "^8.23.1",
    "pg-boss": "^12.38.0",
    "pg-listen": "^1.7.0",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "optionalDependencies": {
    "bullmq": "^6.5.3",
    "ioredis": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12"
  }
}
